# Google Gemini API Key (dapat gratis di https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Nomor WhatsApp kamu (biar cuma kamu yang bisa pakai)
# Contoh: 6281234567890 (tanpa +, tanpa spasi)
OWNER_NUMBER=

# Bot name
BOT_NAME=Lyra

# Default personality: casual or professional
DEFAULT_PERSONALITY=casual

# Server port
PORT=3000

# Database path
DATABASE_PATH=./data/memoris.db
